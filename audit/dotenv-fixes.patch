+    def tracking_open(*args, **kwargs):
+        seen.append(kwargs.get("encoding"))
+        return real_open(*args, **kwargs)
+
+    with mock.patch("builtins.open", tracking_open):
+        with stream_file(dotenv_path) as stream:
+            stream.read()
+
+    assert seen == ["utf-8"]
