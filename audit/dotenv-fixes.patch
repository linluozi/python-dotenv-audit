+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"])
+def test_parse_stream_recovers_whole_line_on_invalid_statement(newline):
+    """
+    After a malformed statement the parser must consume the *entire* line
+    terminator, and keep the line count in sync with the real file.
+
+    With CRLF input, `_rest_of_line` used to match only the `\r` and leave the
+    `\n` to be attributed to the next binding. That shifted every later
+    reported line number by one and, because `set_key`/`unset_key` echo
+    `Binding.original.string` back out, deleting the following statement also
+    deleted its newline and glued two lines together.
+    """
+    text = newline.join(["a=1", "=bad", "b=2", "a: bad", "c=3"]) + newline
+
+    bindings = list(parse_stream(io.StringIO(text)))
+
+    assert [(b.key, b.error, b.original.line) for b in bindings] == [
+        ("a", False, 1),
+        (None, True, 2),
+        ("b", False, 3),
+        (None, True, 4),
+        ("c", False, 5),
+    ]
+    # Every binding owns a complete terminator, so echoing the untouched ones
+    # back cannot merge lines.
+    for binding in bindings:
+        assert binding.original.string.endswith(newline)
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"])
+def test_parse_stream_crlf_is_a_single_line_break(newline):
+    text = newline.join(["a=1", "b=2", "c=3"]) + newline
+
+    bindings = list(parse_stream(io.StringIO(text)))
+
+    assert [b.original.line for b in bindings] == [1, 2, 3]
+    assert [b.value for b in bindings] == ["1", "2", "3"]
